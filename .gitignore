# CH4114 Molecular Simulation Tutorials — .gitignore
# Author: Shuvam Banerji Seal

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv ──────────────────────────────────────────────────────────────────────
# uv keeps its own cache outside the project; nothing extra needed here.
# (uv.lock IS committed on purpose — it is the reproducibility contract.)

# ── Testing / tooling ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/

# ── Jupyter / notebooks ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*_files/

# ── LaTeX / Beamer build artifacts (garbage — never commit) ─────────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.xdv
*.dvi
*.ps
*.bak
*.sav
*~

# ── OS / editor noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
